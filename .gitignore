# Wine prefix and backups (many GB, machine-specific)
/Prefix/
/backups/

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# Downloaded artwork
/launcher/heroes/

# Bundled third-party binaries
/winetricks
/cabextract

# Per-game Wine prefixes
/prefixes/

# Stored artwork is user data, like the prefixes
/launcher/artwork/

# Release archives
/dist/

# Your game library is personal: absolute paths into your home
# directory, and nobody else's business when this is published.
# games/ itself is tracked via .gitkeep so a clone still has the folder.
/games/*
!/games/.gitkeep
